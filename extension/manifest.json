{
  "manifest_version": 3,
  "name": "栖页",
  "version": "2.0.2",
  "description": "按网站整理标签页，保存稍后查看的网页，记录浏览时长，专注于当前任务。",
  "permissions": ["tabs", "storage", "alarms", "idle", "notifications"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "栖页",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
